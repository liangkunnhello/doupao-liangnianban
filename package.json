{
  "name": "doupao-liangnianban",
  "private": true,
  "version": "0.7.51",
  "description": "豆泡两年半：图片生成、编辑与批量变量提示词工具",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liangkunnhello/doupao-liangnianban.git"
  },
  "homepage": "https://github.com/liangkunnhello/doupao-liangnianban#readme",
  "bugs": {
    "url": "https://github.com/liangkunnhello/doupao-liangnianban/issues"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "mock:api": "node scripts/mock-image-api.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder",
    "electron:preview": "vite build && electron .",
    "release": "npm run electron:build -- --publish always",
    "release:dry": "npm run electron:build -- --publish never"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "clsx": "^2.1.1",
    "core-js": "^3.49.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.2",
    "framer-motion": "^12.43.0",
    "image-size": "^2.0.2",
    "lenis": "^1.3.25",
    "lucide-react": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.4.3",
    "zundo": "^2.3.0",
    "zustand": "^5.0.5"
  },
  "overrides": {
    "mdast-util-gfm-autolink-literal": "2.0.0",
    "dompurify": "^3.4.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "react-test-renderer": "^19.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.cooksleep.doupao-v2",
    "productName": "豆泡两年半",
    "directories": {
      "output": "release"
    },
    "icon": "public/icon.ico",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "liangkunnhello",
      "repo": "doupao-liangnianban",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
